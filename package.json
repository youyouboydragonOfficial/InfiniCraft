{
  "name": "infinicraft",
  "productName": "InfiniCraft",
  "version": "1.0.0",
  "description": "Infinite realistic voxel sandbox game - survival & creative",
  "main": "electron/main.cjs",
  "author": "youyouboydragonOfficial",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "vite build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.youyouboydragon.infinicraft",
    "productName": "InfiniCraft",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "InfiniCraft-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "InfiniCraft-${version}-portable.exe"
    }
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.2"
  }
}
